<?xml version="1.0" encoding="utf-8"?>
<!-- 字表屬使用者持有的授權資料，不參與雲端備份與裝置轉移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
